# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.syndyemadefoundation.org
# Set to "true" on preview/staging deployments to keep search engines out
NEXT_PUBLIC_NOINDEX=

# Stripe (card donations). Leave empty to disable the card option.
STRIPE_SECRET_KEY=
# PayPal hosted donate button ID (from PayPal dashboard > Pay & Get Paid > Donate)
NEXT_PUBLIC_PAYPAL_DONATE_BUTTON_ID=
# Flutterwave payment link for MTN / Orange Mobile Money (XAF)
NEXT_PUBLIC_FLUTTERWAVE_PAYMENT_LINK=

# Where volunteer / partnership applications are forwarded (webhook: Zapier, Make, Slack, etc.)
FORMS_WEBHOOK_URL=
